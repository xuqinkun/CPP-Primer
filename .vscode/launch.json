{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: 调试当前文件",
      "type": "lldb",
      "request": "launch",
      "program": "${fileDirname}/build/${fileBasenameNoExtension}.exe",
      "args": [],
      "cwd": "${fileDirname}",
      "preLaunchTask": "C++: 仅编译"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/Projects/CPP-Primer/ch01",
      "program": "d:/Projects/CPP-Primer/ch01/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}