{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: 调试当前文件",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "stopOnEntry": false,
            "breakpointMode": "file",
            "sourceMap": {
                "/cygdrive/d/Projects/CPP-Primer": "${workspaceFolder}",
                "/cygdrive/d": "D:"
            },
            "preLaunchTask": "C++: 仅编译"
        },
        {
            "name": "C++: 调试当前文件 (gdb 外部终端)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "externalTerminal",
            "externalConsole": true,
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\cygwin64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "/cygdrive/d": "d:\\",
                "/cygdrive/c": "c:\\"
            },
            "preLaunchTask": "C++: 仅编译"
        }
    ]
}
