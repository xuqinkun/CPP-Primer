{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: 编译并运行",
            "type": "shell",
            "command": "taskkill /F /IM \"${fileBasenameNoExtension}.exe\" >nul 2>&1 & taskkill /F /IM outDebug.exe >nul 2>&1 & if not exist \"${workspaceFolder}\\build\\${relativeFileDirname}\" mkdir \"${workspaceFolder}\\build\\${relativeFileDirname}\" & g++ -Wall -Wextra -Wpedantic -Wshadow -g3 -O0 \"${file}\" -o \"${workspaceFolder}\\build\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe\" && \"${workspaceFolder}\\build\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe\"",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: 仅编译",
            "type": "shell",
            "command": "taskkill /F /IM \"${fileBasenameNoExtension}.exe\" >nul 2>&1 & taskkill /F /IM outDebug.exe >nul 2>&1 & if not exist \"${workspaceFolder}\\build\\${relativeFileDirname}\" mkdir \"${workspaceFolder}\\build\\${relativeFileDirname}\" & g++ -Wall -Wextra -Wpedantic -Wshadow -g3 -O0 \"${file}\" -o \"${workspaceFolder}\\build\\${relativeFileDirname}\\${fileBasenameNoExtension}.exe\"",
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang.exe 生成活动文件",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Tools\\Llvm\\x64\\bin\\clang.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Tools\\Llvm\\x64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}