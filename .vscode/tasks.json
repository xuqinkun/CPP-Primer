{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: 仅编译",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\compile-native.bat",
            "args": [
                "${file}",
                "${fileDirname}",
                "${fileBasenameNoExtension}",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "focus": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "C++: 编译并运行",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\run-native.bat",
            "args": [
                "g++",
                "${fileDirname}",
                "${fileBasename}",
                "${fileBasenameNoExtension}",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
