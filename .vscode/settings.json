{
    "code-runner.executorMap": {
        "cpp": "\"$workspaceRoot\\.vscode\\run-native.bat\" g++ . $fileName $fileNameWithoutExt \"$workspaceRoot\"",
        "c": "\"$workspaceRoot\\.vscode\\run-native.bat\" gcc . $fileName $fileNameWithoutExt \"$workspaceRoot\""
    },
    "code-runner.fileDirectoryAsCwd": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.runInTerminal": true,
    "debug.focusTerminalOnStart": true
}
